# Names only; never commit values. Copy to .env (git-ignored) for local runs.
# Phase 1: the current Supabase Postgres, through the transaction pooler (port 6543).
DATABASE_URL=
# Signs session cookies; the same value as the Next.js server's AUTH_SECRET (32+ random characters).
AUTH_SECRET=
# The storefront's address, used in e-mailed links (confirm account, reset password).
NEXT_PUBLIC_SITE_URL=
# Account e-mails; without them (local) accounts are confirmed at once and links are logged.
GMAIL_USER=
GMAIL_APP_PASSWORD=
OWNER_EMAILS=
ADMIN_EMAILS=
# Next.js base URL and shared secret for app/api/internal/revalidate (catalog cache).
NEXT_URL=
REVALIDATE_SECRET=
SENTRY_DSN=
# local | production
ENV=local
PORT=4000
