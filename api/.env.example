# Names only; never commit values. Copy to .env (git-ignored) for local runs.
# Phase 1: the current Supabase Postgres, through the transaction pooler (port 6543).
DATABASE_URL=
# Supabase project URL; only used to fetch the JWT signing keys (/auth/v1/.well-known/jwks.json).
SUPABASE_URL=
# Optional: the same JWKS JSON the Next.js app uses, to skip fetching the keys.
SUPABASE_JWKS=
OWNER_EMAILS=
ADMIN_EMAILS=
# Next.js base URL and shared secret for app/api/internal/revalidate (catalog cache).
NEXT_URL=
REVALIDATE_SECRET=
SENTRY_DSN=
# local | production
ENV=local
PORT=4000
