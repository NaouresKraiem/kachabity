# The production server's .env (/opt/kachabity/.env). Names only: the values live in the GitHub
# secret PROD_ENV, which the deploy workflow writes here. Never commit real values.

# Postgres (the db service). Use letters and digits only in the password (it goes into a URL).
POSTGRES_USER=kachabity
POSTGRES_PASSWORD=
POSTGRES_DB=kachabity

# Sessions: the same value as AUTH_SECRET on Vercel (32+ random characters).
AUTH_SECRET=
# The storefront on Vercel: links in e-mails, and the cache refresh (same REVALIDATE_SECRET on Vercel).
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_URL=https://www.example.com
REVALIDATE_SECRET=

# Cloudflare R2 (an R2 API token with read/write on the three buckets).
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
FILES_PUBLIC_URL=https://files.example.com
BACKUP_BUCKET=kachabity-backups

# Cloudflare Tunnel: terraform output -raw tunnel_token
CLOUDFLARE_TUNNEL_TOKEN=

# Roles that don't depend on the account.
OWNER_EMAILS=
ADMIN_EMAILS=

# Optional services (leave empty to turn off).
GMAIL_USER=
GMAIL_APP_PASSWORD=
VAPID_KEYS=
VAPID_SUBJECT=mailto:you@example.com
COLISSIMO_ADD_TOKEN=
COLISSIMO_TRACKING_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SENTRY_DSN=
STOCK_API_KEY=
