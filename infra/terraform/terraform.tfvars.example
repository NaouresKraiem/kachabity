# Copy to terraform.tfvars (git-ignored) and fill in. See docs/DEPLOY.md for where each value comes from.
oci_tenancy_ocid     = "ocid1.tenancy.oc1..xxxx"
oci_user_ocid        = "ocid1.user.oc1..xxxx"
oci_fingerprint      = "aa:bb:cc:..."
oci_private_key_path = "~/.oci/oci_api_key.pem"
oci_region           = "eu-frankfurt-1"
oci_compartment_ocid = "ocid1.tenancy.oc1..xxxx"

admin_ssh_public_key  = "ssh-ed25519 AAAA... you@laptop"
deploy_ssh_public_key = "ssh-ed25519 AAAA... github-deploy"

cloudflare_account_id = "0123456789abcdef0123456789abcdef"
cloudflare_zone_id    = "0123456789abcdef0123456789abcdef"
domain                = "kachabity.com"
# cloudflare_api_token: better from the environment, TF_VAR_cloudflare_api_token=...
